# ============================================================
# ConnectSphere / AeroMeet — Environment Variables Reference
# ============================================================
# Copy this file to .env (for Docker Compose) or the relevant
# backend/.env / frontend/.env.local as needed, then fill in
# real values. NEVER commit files with real secrets.

# ── DATABASE ─────────────────────────────────────────────────
DATABASE_URL=postgresql://connectsphere:password@localhost:5432/connectsphere

# ── JWT ──────────────────────────────────────────────────────
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── EMAIL (SMTP / Nodemailer) ─────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="ConnectSphere" <noreply@connectsphere.app>

# ── GOOGLE OAUTH ──────────────────────────────────────────────
# Client ID is safe to expose in frontend (NEXT_PUBLIC_GOOGLE_CLIENT_ID)
# Client Secret must stay server-side only
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── APP / SERVER ──────────────────────────────────────────────
PORT=4000
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# ── FRONTEND PUBLIC VARS (Next.js) ───────────────────────────
# Safe to expose — no secrets here
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── SUPABASE ──────────────────────────────────────────────────
# Anon key is intentionally public (enforces RLS). Service Role key is NOT needed here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── LIVEKIT ───────────────────────────────────────────────────
# Server-side token signing keys — never prefix with NEXT_PUBLIC_
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Public WebSocket URL (safe to expose)
NEXT_PUBLIC_LIVEKIT_URL=

# ── AI API KEYS ───────────────────────────────────────────────
# These are used only in Next.js Server API Routes (/api/copilot)
# Do NOT prefix with NEXT_PUBLIC_ — that would expose them to the browser bundle
NVIDIA_API_KEY=
GEMINI_API_KEY=

# ── OPTIONAL: BREVO / RESEND (alternative email providers) ───
BREVO_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=